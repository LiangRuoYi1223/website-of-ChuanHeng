# Browser-visible values only. Never use sb_secret_ or a service_role JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CONTENT_MODE=preview

# Route basemaps are single static images prepared by the upload backend.
# Viewing a saved route never requests third-party map tiles.
# Legacy VITE_TERRAIN_TILE_* variables no longer affect route/activity viewers.

# Server-only configuration for the future Cloudflare Worker (not VITE_ values).
# Configure these on the Worker after local acceptance; no service-role key required.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
