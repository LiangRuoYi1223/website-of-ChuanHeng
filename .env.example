# Browser-visible values only. Never use sb_secret_ or a service_role JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CONTENT_MODE=preview

# Optional terrain tiles. "offline" draws coordinates without network requests.
# Custom XYZ URL must use HTTPS and requires a plain-text attribution.
# VITE_TERRAIN_TILE_URL=offline
# VITE_TERRAIN_TILE_ATTRIBUTION=
# VITE_TERRAIN_TILE_MAX_ZOOM=17

# Server-only configuration for the future Cloudflare Worker (not VITE_ values).
# Configure these on the Worker after local acceptance; no service-role key required.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
