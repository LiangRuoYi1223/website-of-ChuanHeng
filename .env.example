# Cloud secrets: put real values in .env.local (ignored by Git).
# Copy Supabase Connect > Transaction pooler URI, with an encoded password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional Supabase CA certificate PEM if needed by your project.
DATABASE_CA_CERT=
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Backend secret key (sb_secret_...) or legacy service_role key; never VITE_*.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=chuanheng-uploads
# Exact HTTPS domain, no trailing slash. Preview deployments need their own value.
SITE_ORIGIN=https://YOUR_DOMAIN
# Used ONLY by the one-time initialization command, never uploaded to hosting.
INITIAL_ADMIN_PASSWORD=
# Create the president account later with npm run president:setup (add -- --cloud for Supabase).
# Fill these ONLY in a private .env.local / --env-file file; never upload them to hosting.
PRESIDENT_USERNAME=
PRESIDENT_PASSWORD=
# Optional account display name; defaults to 协会社长.
PRESIDENT_DISPLAY_NAME=
# Legacy Vercel only; not needed for Cloudflare Workers.
NODEJS_HELPERS=0
