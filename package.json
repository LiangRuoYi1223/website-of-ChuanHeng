{
  "name": "chuanheng-mountaineering",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --watch server/index.mjs",
    "build": "node scripts/check-handbook.mjs && tsc -b && vite build",
    "build:cloud": "npm run build && node scripts/prepare-vercel.mjs",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run",
    "cloud:setup": "node --env-file=.env.local scripts/setup-cloud.mjs",
    "cloud:check": "node --env-file=.env.local scripts/setup-cloud.mjs --check",
    "president:setup": "node scripts/setup-president.mjs",
    "handbook": "node scripts/build-handbook.mjs",
    "handbook:check": "node scripts/check-handbook.mjs",
    "start": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "start:api": "node server/index.mjs",
    "start:cloud": "node server/start-cloud.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^7.1.9",
    "wrangler": "^4.149.0"
  }
}
