  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-local.mjs --host 127.0.0.1 --port 5178 --configLoader runner",
    "build": "node scripts/vite-local.mjs build --configLoader runner",
