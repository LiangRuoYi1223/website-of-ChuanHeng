    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "vite": "7.3.7",
    "wrangler": "4.156.0"
  }
